<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsService>true</UseWindowsService>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SafeWebGateway</AssemblyName>
    <RootNamespace>SafeWebGateway</RootNamespace>
    <Product>SafeWeb Gateway</Product>
    <Description>Local Windows Mobile Hotspot DNS and HTTPS SNI filtering gateway.</Description>
    <Version>4.5.0</Version>
    <AssemblyVersion>4.5.0.0</AssemblyVersion>
    <FileVersion>4.5.0.0</FileVersion>
    <InformationalVersion>4.5.0</InformationalVersion>
    <Copyright>Copyright (c) 2026 SafeWeb Gateway contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\WinDivert.dll" Link="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\WinDivert.dll')" />
    <Content Include="..\..\native\WinDivert64.sys" Link="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\WinDivert64.sys')" />
  </ItemGroup>
</Project>
